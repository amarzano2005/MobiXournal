<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer, authored here rather than by jpackage.

  jpackage's MSI has one feature and no screen that offers a choice, so it cannot carry the option this
  installer must have: `.mobix`, `.pmobix` and `.xopp` associations that a reader may switch **off** in the
  feature tree (they are on by default). The app image is still jpackage's — `:desktop:createDistributable`, with
  its icon and its runtime — and `scripts/desktop-package.ps1` harvests it with heat, compiles this file
  with candle and links the MSI with light (`docs/tools.md`, *Desktop installer*).

  Per user on purpose: no administrator prompt, the app under %LOCALAPPDATA%, the shortcut and the
  classes in HKCU. The UpgradeCode is the one the jpackage MSI carried, so this package upgrades an
  installation made by the previous build instead of sitting beside it. Variables come from candle:
  `$(var.Version)` (desktop/build.gradle.kts's packageVersion), `$(var.AppImage)` and
  `$(var.LicenseFile)`.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="MobiXournal"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="MobiXournal"
           UpgradeCode="6f1f3d64-9a0c-4a3e-9a02-0f4f1a2b7c11">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="MobiXournal for Windows: native .mobix documents, lossless .xopp interchange" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of MobiXournal is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/amarzano2005/MobiXournal" />
    <Icon Id="AppIcon" SourceFile="$(var.AppImage)\MobiXournal.exe" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <!-- A folder of its own under %LOCALAPPDATA%, as jpackage's per-user install used. -->
        <Directory Id="MobiXournalFolder" Name="MobiXournal">
          <Directory Id="INSTALLDIR" Name="MobiXournal" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="MobiXournal" />
      </Directory>
      <!-- The reader's own desktop: a per-user install writes here without an administrator prompt. -->
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="3F2C1A88-5E1B-4C0D-9A11-8B7C6D5E4F01">
        <Shortcut Id="StartMenuShortcut"
                  Name="MobiXournal"
                  Description="MobiXournal for Windows"
                  Target="[INSTALLDIR]MobiXournal.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <!-- The shortcut's keypath: a per-user registry value, so the component is installed for the reader. -->
        <RegistryValue Root="HKCU" Key="Software\MobiXournal" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C4D5E6F7-1A2B-4C3D-9E8F-0A1B2C3D4E05">
        <Shortcut Id="DesktopShortcutLink"
                  Name="MobiXournal"
                  Description="MobiXournal for Windows"
                  Target="[INSTALLDIR]MobiXournal.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon" />
        <!-- A key of its own, so the desktop icon can come and go without touching the Start menu's. -->
        <RegistryValue Root="HKCU" Key="Software\MobiXournal" Name="desktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <!-- `.mobix`: the app's own paged container. A double-click runs the launcher with the document. -->
      <Component Id="MobixAssociation" Guid="7D4B2C19-6A3E-4F58-B0C2-1D9E8F7A6B02">
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.mobix"
                       Type="string" Value="MobiXournal notebook" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.mobix\DefaultIcon"
                       Type="string" Value="[INSTALLDIR]MobiXournal.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.mobix\shell\open\command"
                       Type="string" Value="&quot;[INSTALLDIR]MobiXournal.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.mobix"
                       Type="string" Value="MobiXournal.mobix" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.mobix" Name="Content Type"
                       Type="string" Value="application/vnd.mobixournal+zip" />
      </Component>

      <!-- `.pmobix`: a portable copy, which is a `.mobix` container under its export suffix, so it shares
           the same declared type and opens in the same launcher (`docs/mobix-assets.md`). -->
      <Component Id="PmobixAssociation" Guid="A7F3C2D1-5B64-4E29-8C13-6D2B9F0A7E04">
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.pmobix"
                       Type="string" Value="MobiXournal portable notebook" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.pmobix\DefaultIcon"
                       Type="string" Value="[INSTALLDIR]MobiXournal.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.pmobix\shell\open\command"
                       Type="string" Value="&quot;[INSTALLDIR]MobiXournal.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.pmobix"
                       Type="string" Value="MobiXournal.pmobix" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.pmobix" Name="Content Type"
                       Type="string" Value="application/vnd.mobixournal+zip" />
      </Component>

      <!-- `.xopp`: the interchange format, opened by the same launcher and saved back as `.xopp`. -->
      <Component Id="XoppAssociation" Guid="B93E5A21-0C7D-4E63-8A54-3F1C2B9D7E03">
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.xopp"
                       Type="string" Value="Xournal++ note (MobiXournal)" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.xopp\DefaultIcon"
                       Type="string" Value="[INSTALLDIR]MobiXournal.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MobiXournal.xopp\shell\open\command"
                       Type="string" Value="&quot;[INSTALLDIR]MobiXournal.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.xopp"
                       Type="string" Value="MobiXournal.xopp" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.xopp" Name="Content Type"
                       Type="string" Value="application/x-xopp" />
      </Component>
    </DirectoryRef>

    <!-- The app image: every file the window needs, runtime included, harvested with heat (`AppFiles`). -->
    <Feature Id="MainFeature"
             Title="MobiXournal"
             Description="The editor, its runtime and the Start menu shortcut."
             Level="1"
             Absent="disallow"
             Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!--
      The installer's one question, answered **yes** on a fresh install: `Level=1` is what installs it by
      default, and `Absent="allow"` is what lets the feature tree switch it off, so a reader who keeps
      `.mobix`, `.pmobix` and `.xopp` on another program is not overruled by the installer. (`Absent` is
      WiX 3's spelling of this — it sets the MSI Feature table's *UI may allow absent* bit.)
    -->
    <Feature Id="FileAssociations"
             Title="Associate .mobix, .pmobix and .xopp files"
             Description="Opens MobiXournal when you double-click a .mobix notebook, a .pmobix portable copy or an .xopp file."
             Level="1"
             Absent="allow"
             Display="expand">
      <ComponentRef Id="MobixAssociation" />
      <ComponentRef Id="PmobixAssociation" />
      <ComponentRef Id="XoppAssociation" />
    </Feature>

    <!--
      Also answered **yes** by default and also a choice: an icon on the desktop is wanted by many people
      and unwanted by those who keep their desktop for their own files.
    -->
    <Feature Id="DesktopShortcut"
             Title="Desktop shortcut"
             Description="Puts a MobiXournal icon on the desktop."
             Level="1"
             Absent="allow"
             Display="expand">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UIRef Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
  </Product>
</Wix>
