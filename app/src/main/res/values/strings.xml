<resources>
    <!-- The launcher/task label. This app is an **unofficial** Android editor for Xournal++
         documents, named MobiXournal; the label is the app's own name, so it is never mistaken
         for the official Xournal++ app. The project name is "MobiXournal" (see README). -->
    <string name="app_name">MobiXournal</string>
    <string name="open_document">Open .xopp</string>
    <string name="save_document">Save</string>
    <string name="tool_pen">Pen</string>
    <string name="tool_highlighter">Highlighter</string>
    <string name="tool_eraser">Eraser</string>
    <!-- Shown when a tab's cached snapshot exists but couldn't be parsed; the file is left on disk
         untouched so it can still be recovered, rather than silently blanking the tab. -->
    <string name="restore_failed">Couldn\'t restore %1$s — its cached copy is unreadable. The file was left untouched.</string>
    <string name="document_read_only">Document is read-only</string>
    <!-- A gesture that needs pages (selection, the clipboard, vertical space) was tried on an
         infinite canvas, which has none (docs/infinite-canvas.md → What a board can be edited with).
         Names what does work before what does not: the old wording ("drawing only") read as if the
         canvas were broken, when only the page-shaped gestures are refused. -->
    <string name="infinite_canvas_only_drawing">On an infinite canvas, drawing, erasing, text/image placement and undo work. Selection, moving and PDF text need pages, so they are not available here.</string>
</resources>
